(ns worker-http-test
  "The compiled Worker's HTTP surface, both directions.

    kbb --backend sci test/worker_http_test.cljk   (after npm run build)"
  (:require ["node:assert/strict" :as a] ["node:url" :as url] ["node:path" :as path]))

(def cpm "[{\"id\":\"cmp-1\",\"advertiser\":\"did:key:zADV\",\"creative\":{\"type\":\"text\",\"click-url\":\"https://example.test/ad\",\"copy\":\"Ad copy\"},\"bid\":{\"model\":\"cpm\",\"usd\":\"4.00\"},\"targeting\":{\"placements\":[\"go-wait\"]},\"budget\":{\"total-usd\":\"50.00\",\"spent-micros\":0},\"status\":\"active\"}]")

(def sunset "Thu, 31 Dec 2026 00:00:00 GMT")
(def static-base "https://raw.githubusercontent.com/network-awai/app-itonami-adserver/main/public")

(defn call [w env method path]
  (.fetch w (js/Request. (str "https://ads.x402.nexus" path) #js {:method method}) env #js {}))

(defn json! [p expected]
  (.then p (fn [r] (a/equal (.-status r) expected (str "status " (.-url r))) (.json r))))

(defn expect-deprecated! [p successor-file]
  ;; p is the fetch Promise from (call ...): read .headers only on the
  ;; RESOLVED Response, inside .then, then pass the Response through so
  ;; json! can status-check and .json it. (Reading .-headers on the Promise
  ;; itself is undefined and never evaluates the assertions.)
  (.then p
    (fn [r]
      (a/equal (.get (.-headers r) "deprecation") "true" "Deprecation header")
      (a/equal (.get (.-headers r) "sunset") sunset "Sunset header")
      (a/equal (.get (.-headers r) "link")
               (str "<" static-base "/" successor-file ">; rel=\"successor-version\"")
               "Link successor-version header")
      r)))

(-> (js/eval (str "import(" (js/JSON.stringify (str (url/pathToFileURL (path/resolve "dist/worker.js")))) ")"))
    (.then (fn [m]
             (let [w (.-default m)
                   empty-env #js {:CAMPAIGNS_JSON "[]"}
                   one-env #js {:CAMPAIGNS_JSON cpm}]
               (-> (json! (expect-deprecated! (call w one-env "GET" "/campaigns") "campaigns.json") 200)
                   (.then (fn [r]
                            (a/equal (.-service r) "adserver")
                            (a/equal (.-ok r) true)
                            (a/equal (.-schema r) "awai.adserver.campaigns.v1")
                            (a/equal (aget r "generated-at") (aget r "generatedAt") "envelope generated-at == static generatedAt")
                            (a/equal (.-count r) 1 "embedded static content (count 1)")
                            (a/equal (boolean (.-gone r)) false "no 410-pointer body")))
                   (.then (fn [_]
                            (json! (expect-deprecated! (call w empty-env "GET" "/campaigns") "campaigns.json") 200)))
                   (.then (fn [r]
                            (a/equal (.-ok r) true "static body is env-independent")
                            (json! (expect-deprecated! (call w one-env "GET" "/catalog") "catalog.json") 200)))
                   (.then (fn [r]
                            (a/equal (.-service r) "adserver")
                            (a/equal (.-ok r) true)
                            (a/equal (.-schema r) "awai.adserver.catalog.v1")
                            (a/equal (.-campaigns r) 1 "embedded static catalog count")
                            (json! (call w one-env "GET" "/serve?slot=go-wait") 200)))
                   (.then (fn [r]
                            (a/equal (.-kind r) "paid") (a/equal (aget r "campaign-id") "cmp-1")
                            (json! (call w empty-env "GET" "/serve?slot=go-wait") 200)))
                   (.then (fn [r]
                            (a/equal (.-kind r) "house" "no campaigns -> the house ad, never an error")
                            (json! (call w one-env "GET" "/health") 200)))
                   (.then (fn [r]
                            (a/equal (.-ok r) true)
                            (println "CHECKED\t6\tadserver http: /campaigns 200 deprecated + static, /catalog 200 deprecated + static; /serve paid + house; /health")))))))
    (.catch (fn [e] (.error js/console e) (js/process.exit 1))))

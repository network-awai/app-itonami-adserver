{
  "name": "adserver",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  // cloud-kotoba owns the zone x402.nexus (nexus-x402 Worker); pin the account
  // so deploys are not ambiguous across the operator's accounts.
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  // Single canonical hostname. custom_domain creates the DNS record + cert.
  "routes": [{ "pattern": "ads.x402.nexus", "custom_domain": true }],
  "vars": {
    // Campaign registry: JSON array of {id, advertiser, creative, bid{model,usd},
    // targeting{tier,formats,placements,geo}, budget, status}. Public creative +
    // bids only, no keys. cloud-itonami's governor manages the lifecycle.
    // This var is the single source: scripts/campaigns_static_export.py reads
    // it at build time for public/campaigns.json; scripts/embed_static_json.py
    // embeds those files into the Worker bundle, which serves them at
    // GET /campaigns + /catalog (200, Deprecation/Sunset headers).
    // One row: honest house placeholder (paused, zero bid/budget) whose
    // creative material is yataverse. No paid campaign yet; this row only
    // proves the registry -> static -> bundle path with count:1.
    "CAMPAIGNS_JSON": "[{\"id\":\"yataverse-house-placeholder\",\"advertiser\":\"yataverse house placeholder (no paid campaign yet)\",\"creative\":{\"type\":\"text\",\"copy\":\"Placeholder inventory. Creative material is served from yataverse (https://yataverse.com/). No paid campaign yet.\",\"click-url\":\"https://yataverse.com/\"},\"bid\":{\"model\":\"cpm\",\"usd\":\"0.00\"},\"targeting\":{\"tier\":\"general\",\"formats\":[\"rectangle\"],\"placements\":[\"go-wait\"]},\"budget\":{\"total-usd\":\"0.00\",\"spent-micros\":0},\"status\":\"paused\"}]"
    // ADNET_TREASURY_ADDR (advertiser USDC deposits) via wrangler secret/var.
  }
}
